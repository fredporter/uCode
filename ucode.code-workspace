{
  "folders": [
    {
      "name": "uCode (root)",
      "path": ".",
      "git": {
        "checkoutType": "auto",
      },
    },
    {
      "name": "gridcore",
      "path": "packages/gridcore",
      "git": {
        "checkoutType": "auto",
      },
    },
    {
      "name": "viewport-renderer",
      "path": "packages/viewport-renderer",
      "git": {
        "checkoutType": "auto",
      },
    },
    {
      "name": "agents",
      "path": "agents",
      "git": {
        "checkoutType": "auto",
      },
    },
    {
      "name": "shared",
      "path": "shared",
      "git": {
        "checkoutType": "auto",
      },
    },
    {
      "name": "runtimes",
      "path": "runtimes",
      "git": {
        "checkoutType": "auto",
      },
    },
  ],
  "settings": {
    // Python settings
    "python.defaultInterpreterPath": "/Users/fredbook/.venvs/global/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": ["--line-length=100"],

    // TypeScript/JavaScript settings
    "typescript.preferences.includePackageJson": true,
    "javascript.preferences.includePackageJson": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },

    // Vitest configuration
    "vitest.enable": true,

    // File exclusions
    "files.exclude": {
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.venv": false,
      "**/node_modules": true,
      "**/dist": true,
      "**/.git": true,
    },

    // Search exclusions
    "search.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/.git": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
    },

    // Terminal settings
    "terminal.integrated.shell.osx": "/bin/zsh",
    "terminal.integrated.cursorBlinking": true,

    // Editor settings
    "editor.rulers": [80, 100, 120],
    "editor.minimap.enabled": false,
    "editor.renderWhitespace": "boundary",
    "editor.wordWrap": "on",

    // Emmet settings
    "emmet.includeLanguages": {
      "javascript": "javascriptreact",
      "typescript": "html",
      "typescriptreact": "html",
    },

    // Files associations
    "files.associations": {
      "*.module.css": "css",
      "*.css": "css",
    },

    // Search settings
    "search.followSymlinks": false,
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-python.debugpy",
      "ms-python.black-formatter",
      "ms-python.flake8",
      "ms-python.vscode-python-envs",
      "esbenp.prettier-vscode",
      "redhat.vscode-yaml",
      "github.vscode-github-actions",
      "github.vscode-pull-request-github",
      "mikestead.dotenv",
      "vizards.deepseek-v4-for-copilot",
    ],
  },
}
